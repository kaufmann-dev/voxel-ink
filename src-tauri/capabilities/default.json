{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Minimum local capability for the VoxelInk editor window",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-request-open-ticket",
    "allow-read-open-ticket",
    "allow-request-save-ticket",
    "allow-write-save-ticket",
    "allow-release-source",
    "allow-confirm-exit",
    "allow-cancel-exit"
  ]
}
