{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main",
        {
          "identifier": "wdio-test",
          "description": "Test-only WebdriverIO automation capability",
          "local": true,
          "windows": ["main"],
          "permissions": [
            "wdio:default",
            "wdio-webdriver:default",
            "core:window:allow-set-focus"
          ]
        }
      ]
    }
  }
}
