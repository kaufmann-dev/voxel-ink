<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>app.voxelink.editor</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>VoxelInk</name>
  <summary>Inspect and edit volumetric voxel masks</summary>
  <developer id="app.voxelink">
    <name>VoxelInk contributors</name>
  </developer>
  <description>
    <p>
      VoxelInk is a native voxel editor with synchronized axial, coronal,
      sagittal, and three-dimensional views.
    </p>
    <p>
      It works locally with NIfTI, BINVOX, and single-model MagicaVoxel files.
    </p>
  </description>
  <url type="homepage">https://github.com/kaufmann-dev/voxel-ink</url>
  <launchable type="desktop-id">app.voxelink.editor.desktop</launchable>
  <provides>
    <binary>voxel-ink</binary>
    <mediatype>application/x-nifti</mediatype>
    <mediatype>application/x-nifti-gzip</mediatype>
    <mediatype>application/x-binvox</mediatype>
    <mediatype>application/x-magica-voxel</mediatype>
  </provides>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.1.0" date="2026-10-11"/>
  </releases>
</component>
